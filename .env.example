# Required for photo analysis. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; defaults to Gemini 3.8 Flash. Free-tier access and limits vary.
GEMINI_MODEL=gemini-3.8-flash
# USDA FoodData Central key (free): https://fdc.nal.usda.gov/api-key-signup.html
# Optional for trying the app; DEMO_KEY has strict limits.
USDA_API_KEY=DEMO_KEY
